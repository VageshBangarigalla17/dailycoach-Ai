{
  "version": 2,
  "installCommand": "npm install --legacy-peer-deps && cd server && npm install --legacy-peer-deps && cd ..",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 512,
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  }
}
